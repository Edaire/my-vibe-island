{
  "rows": [
    {
      "id": "uds-uid-mismatch",
      "hostId": "devbox",
      "hostAlias": "devbox",
      "tunnelKind": "uds",
      "commandKinds": [
        "sshConfigSnippet",
        "socketCleanup",
        "helperReinstall",
        "hookStatus",
        "tunnel"
      ],
      "commands": [
        "sshConfigSnippet=Host devbox\n    HostName devbox.example.com\n    User dev\n    Port 22\n    RemoteForward /tmp/my-vibe-island-501.sock /tmp/my-vibe-island-502.sock\n    SetEnv MY_VIBE_ISLAND_SOCKET_PATH=/tmp/my-vibe-island-501.sock\n    SetEnv VIBE_ISLAND_SOCKET_PATH=/tmp/my-vibe-island-501.sock\n    StreamLocalBindUnlink yes",
        "socketCleanup=rm -f /tmp/my-vibe-island-501.sock",
        "helperReinstall=scp my-vibe-island-hooks devbox:~/.local/bin/my-vibe-island-hooks",
        "hookStatus=~/.local/bin/my-vibe-island-hooks health",
        "tunnel=ssh -N devbox"
      ],
      "allRequireUserRun": true
    },
    {
