  {
    "name": "ghostty-session",
    "handlerId": "ghostty",
    "precision": "exactWindow",
    "input": {
      "sessionId": "s-ghostty",
      "source": "codex",
      "bundleId": "com.mitchellh.ghostty",
      "isGhosttyFamilyHost": true,
      "termSessionId": "ghostty-session"
    },
    "expectedAction": {
      "kind": "runAutomation",
      "summary": "run automation",
      "target": "com.mitchellh.ghostty",
      "handlerId": "ghostty",
      "arguments": [
        "tell application id \"com.mitchellh.ghostty\"",
        "activate",
        "repeat with candidateWindow in windows",
        "set candidateWindowId to id of candidateWindow as text",
        "set candidateWindowName to name of candidateWindow as text",
        "if candidateWindowId is \"ghostty-session\" or candidateWindowName is \"ghostty-session\" then",
        "set index of candidateWindow to 1",
        "return",
        "end if",
        "end repeat",
        "error \"Ghostty window not found for session ghostty-session\"",
        "end tell"
      ]
    }
  },
  {
    "name": "iterm-session",
    "handlerId": "iterm",
    "precision": "exactPane",
    "input": {
      "sessionId": "s-iterm",
      "source": "codex",
      "bundleId": "com.googlecode.iterm2",
      "itermSessionId": "session-1"
    },
    "expectedAction": {
      "kind": "runAutomation",
      "summary": "run automation",
      "target": "com.googlecode.iterm2",
      "handlerId": "iterm",
      "arguments": [
        "tell application id \"com.googlecode.iterm2\"",
        "activate",
        "repeat with candidateWindow in windows",
        "repeat with candidateTab in tabs of candidateWindow",
        "repeat with candidateSession in sessions of candidateTab",
        "if id of candidateSession is \"session-1\" then",
        "select candidateWindow",
        "select candidateTab",
        "select candidateSession",
        "return",
        "end if",
        "end repeat",
        "end repeat",
        "end repeat",
        "error \"iTerm session not found for id session-1\"",
        "end tell"
      ]
    }
  },
  {
    "name": "terminal-tty",
    "handlerId": "terminal-tty",
    "precision": "exactWindow",
    "input": {
      "sessionId": "s-terminal",
      "source": "codex",
      "bundleId": "com.apple.Terminal",
      "tty": "/dev/ttys001"
    },
    "expectedAction": {
      "kind": "runAutomation",
      "summary": "run automation",
      "target": "com.apple.Terminal",
      "handlerId": "terminal-tty",
      "arguments": [
        "tell application id \"com.apple.Terminal\"",
        "activate",
        "repeat with candidateWindow in windows",
        "repeat with candidateTab in tabs of candidateWindow",
        "if tty of candidateTab is \"/dev/ttys001\" then",
        "set selected tab of candidateWindow to candidateTab",
        "set index of candidateWindow to 1",
        "return",
        "end if",
        "end repeat",
        "end repeat",
        "error \"Terminal tab not found for tty /dev/ttys001\"",
        "end tell"
      ]
    }
  }
